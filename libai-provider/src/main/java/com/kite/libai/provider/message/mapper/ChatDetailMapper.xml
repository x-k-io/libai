<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kite.libai.provider.message.mapper.ChatDetailMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.kite.libai.provider.message.model.entity.ChatDetail">
        <id column="id" property="id"/>
        <result column="chat_id" property="chatId"/>
        <result column="account_id" property="accountId"/>
        <result column="friend_id" property="friendId"/>
        <result column="relation" property="relation"/>
        <result column="unread" property="unread"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id
        , chat_id, account_id, friend_id, relation, unread, status, created_at
    </sql>

</mapper>
